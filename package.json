  },
  "homepage": "https://github.com/Washington-coder/fastify-boilerplate#readme",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
